# TransitOps Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL connection string (e.g., Neon or local PostgreSQL instance)
DATABASE_URL="postgresql://user:password@localhost:5432/transitops?schema=public"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin
FRONTEND_URL="http://localhost:5173"

# Optional AI Fleet Insights (Google Gemini API)
GEMINI_API_KEY=""
